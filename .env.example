# Rostra server settings. Copy to .env for local work (never commit .env).
# On Netlify: Project configuration → Environment variables → add each one (scope: Functions is enough).
# With none of these set, the app runs in mock mode: fake AI answers, fake transcripts, accounts saved in the browser.

# --- Claude (required for real coaching) ---
ANTHROPIC_API_KEY=
# Force mock answers even when a key exists (tests, deploy previews): 1 or empty
MOCK_AI=
# Optional model overrides (defaults: haiku-5-5 / sonnet-5-5 / opus-5-5) and thinking effort (low|medium|high)
ROSTRA_MODEL_QUICK=
ROSTRA_MODEL_DEFAULT=
ROSTRA_MODEL_COMPLEX=
ROSTRA_EFFORT_COMPLEX=

# --- Accounts and database (Supabase project in an EU region) ---
# Project settings → API: Project URL, anon (publishable) key, service_role key (server only, never in the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Emails allowed to create schools and get teacher invite codes (comma separated)
ROSTRA_ADMIN_EMAILS=
# Private code the admin types instead of a school invite code when joining as a teacher; makes that account the admin.
# Without it nobody can become admin. Letters and digits.
ROSTRA_ADMIN_SETUP_CODE=
# Sign-ups accepted per IP address per hour (a brake on scripted account creation; default 20)
ROSTRA_SIGNUPS_PER_HOUR=

# --- Speech-to-text (pick one; without any, the browser's own speech recognition is used) ---
# Deepgram, EU endpoint (recommended: Bulgarian + EU processing)
DEEPGRAM_API_KEY=
DEEPGRAM_API_URL=https://api.eu.deepgram.com
DEEPGRAM_MODEL=nova-3
# Or any Whisper-compatible API (OpenAI, Groq, Mistral...)
WHISPER_API_KEY=
WHISPER_API_URL=
WHISPER_MODEL=

# --- Limits (per user, per day) ---
ROSTRA_DAILY_CALLS=150
ROSTRA_DAILY_USD=3

# Only for a first smoke test without accounts: lets anyone who can open the site use live AI. Leave empty for schools.
ALLOW_ANON_AI=
